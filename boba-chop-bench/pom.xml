<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.susongyan</groupId>
        <artifactId>boba-chop</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>boba-chop-bench</artifactId>
    <name>BobaChop Bench</name>
    <description>Benchmark suite: cold start, first-walk, steady state, long-SQL linearity</description>

    <dependencies>
        <dependency>
            <groupId>io.github.susongyan</groupId>
            <artifactId>boba-chop-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            ANTLR4 规格语法（F5）：WHITELIST 可执行化陪练，仅进 bench 模块。
            core/diff 零第三方运行时依赖红线不破（内核不用、diff 不用）；
            陪练不当裁判（D7）——差异裁决权在 LEDGER 台账与服务器语法书。
        -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                BobaChopSpec.g4 代码生成：sourceDirectory 约定 = src/main/antlr4，
                目录即包名（io.github.susongyan.bobachop.bench.spec）。
                生成物落 target/generated-sources（checkstyle/CI 只扫 src 下 *.java，不触及）。
            -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.2</version>
                <configuration>
                    <listener>false</listener>
                    <visitor>false</visitor>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
